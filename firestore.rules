rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isGithubBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'github.com'
        && 'github.com' in request.auth.token.firebase.identities
        && '229562872' in request.auth.token.firebase.identities['github.com'];
    }

    function isAdmin() {
      return (isEmailVerified() && (
        request.auth.token.email == 'afrigaming08@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      )) || isGithubBootstrapAdmin();
    }

    function isValidBroadcast(data) {
      return data.keys().hasAll([
          'kind',
          'variant',
          'title',
          'message',
          'actionLabel',
          'actionUrl',
          'senderName',
          'active',
          'authorUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'kind',
          'variant',
          'title',
          'message',
          'actionLabel',
          'actionUrl',
          'senderName',
          'active',
          'authorUid',
          'createdAt',
          'updatedAt'
        ])
        && data.kind in ['toast', 'dialog', 'notification']
        && data.variant in ['info', 'success', 'warning', 'error']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && data.actionLabel is string && data.actionLabel.size() <= 40
        && data.actionUrl is string && data.actionUrl.size() <= 300 && (data.actionUrl == '' || data.actionUrl.matches('^https://.*'))
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 50
        && data.active is bool
        && data.authorUid is string && isValidId(data.authorUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid is string && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
    }

    match /broadcasts/{broadcastId} {
      allow get: if isValidId(broadcastId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(broadcastId)
        && isValidBroadcast(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(broadcastId)
        && isValidBroadcast(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'kind',
          'variant',
          'title',
          'message',
          'actionLabel',
          'actionUrl',
          'senderName',
          'active',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(broadcastId);
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isEmailVerified() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
